# =============================================================================
# 必須設定
# =============================================================================

# OpenAI API キー（URLからのレシピ取り込み機能に必要）
# https://platform.openai.com/api-keys で取得
UWABAMI_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 任意設定（デフォルト値あり）
# =============================================================================

# Basic 認証のユーザー名（デフォルト: admin）
UWABAMI_BASIC_AUTH_USER=admin

# Basic 認証のパスワード（デフォルト: password）
# 本番環境では必ず変更すること
UWABAMI_BASIC_AUTH_PASS=password

# JWT 認証のシークレットキー（必須。`openssl rand -hex 32` などで生成する）
UWABAMI_JWT_SECRET_KEY=hogefuga

# Secure Cookie を使用するかどうか（デフォルト: false）
UWABAMI_SECURE_COOKIE=false

# CloudFront の署名付き URL を使用する場合のシークレットキー（デフォルト: 空文字）
UWABAMI_CLOUDFRONT_SECRET=****************