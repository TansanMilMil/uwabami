# =============================================================================
# 必須設定
# =============================================================================

# OpenAI API キー（URLからのレシピ取り込み機能に必要）
# https://platform.openai.com/api-keys で取得
UWABAMI_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google ログイン（OAuth クライアント ID / シークレット）
# https://console.cloud.google.com/apis/credentials で「ウェブ アプリケーション」として作成
UWABAMI_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
UWABAMI_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google に登録した「承認済みのリダイレクト URI」と完全一致させる
UWABAMI_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ログインを許可する Google アカウントと、ログイン後のユーザー名（カンマ区切り）
# ユーザー名は users テーブルの username に対応する。未登録のユーザー名は初回ログイン時に作られる
UWABAMI_GOOGLE_ALLOWED_ACCOUNTS=me@gmail.com=admin

# JWT 認証のシークレットキー（`openssl rand -hex 32` などで生成する）
UWABAMI_JWT_SECRET_KEY=hogefuga

# =============================================================================
# 任意設定（デフォルト値あり）
# =============================================================================

# Secure Cookie を使用するかどうか（デフォルト: false）
UWABAMI_SECURE_COOKIE=false

# CloudFront の署名付き URL を使用する場合のシークレットキー（デフォルト: 空文字）
UWABAMI_CLOUDFRONT_SECRET=****************